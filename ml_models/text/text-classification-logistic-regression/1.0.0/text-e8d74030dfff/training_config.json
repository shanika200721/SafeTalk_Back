        0.5,
        1.0,
        2.0
      ],
      "class_weight": [
        null,
        "balanced"
      ],
      "max_iter": 3000,
      "random_state": 42
    },
    "logistic_regression": {
      "C": [
        0.5,
        1.0,
        2.0
      ],
      "class_weight": [
        null,
        "balanced"
      ],
      "max_iter": 300,
      "random_state": 42,
      "solver": "liblinear"
    }
  },
  "max_candidate_count": 24,
  "min_validation_suicidal_recall": 0.7,
  "model_name": "text-classification-baseline",
  "model_version": "1.0.0",

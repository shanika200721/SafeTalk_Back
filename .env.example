ENVIRONMENT=development
DATABASE_URL=sqlite:///./suicideprevention.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Resolved by app.ml.common.paths to the repository-level ml_models/ directory.
MODEL_ROOT=../ml_models
UPLOAD_ROOT=./uploaded_audio
FFMPEG_BINARY=ffmpeg
FACE_DETECTOR_REQUIRED=false
FACE_DETECTOR_TIMEOUT_SECONDS=3
REDIS_URL=redis://localhost:6379/0

# PostgreSQL example for production or staging:
# DATABASE_URL=postgresql+psycopg2://suicide_app:change-me@localhost:5432/suicide_prevention
# ENVIRONMENT=staging
# CORS_ORIGINS=https://staging.example.edu
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FACE_DETECTOR_REQUIRED=true
